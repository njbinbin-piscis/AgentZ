+pub const EXCLUDED_SEARCH_DIRECTORY_NAMES: &[&str] = &[
+    ".git",
+    "node_modules",
+    "target",
+    ".cache",
+    "__pycache__",
+    ".vs",
+];
+
+pub fn is_excluded_search_directory(name: &str) -> bool {
+    EXCLUDED_SEARCH_DIRECTORY_NAMES
+        .iter()
+        .any(|excluded| excluded.eq_ignore_ascii_case(name))
+}
 
